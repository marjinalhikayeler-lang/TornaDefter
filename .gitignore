# Bağımlılıklar (Dependencies)
node_modules/
.pnp
.pnp.js

# Derleme çıktıları (Build outputs)
dist/
build/
*.js.map
*.d.ts
!jest.config.js
!nest-cli.json

# Ortam değişkenleri (Environment files)
.env
.env.local
.env.development
.env.staging
.env.production
.env.test
*.env

# IDE ve editör dosyaları
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# İşletim sistemi dosyaları
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# Log dosyaları
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test çıktıları
coverage/
.nyc_output/
test-results/

# Prisma
backend/prisma/migrations/**/migration_lock.toml

# Docker
docker-compose.override.yml

# Flutter
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.dart_tool/
*.iml
*.ipr
*.iws
**/.symlinks/
**/android/local.properties
**/ios/Pods/
**/ios/.symlinks/
web-admin/build/
mobile/build/

# Geçici dosyalar
tmp/
temp/
*.tmp
*.bak
*.backup

# Yedekleme dosyaları
/backups/
*.sql.gz
*.dump

# Puppeteer / Chrome
.local-chromium/

# Firebase
firebase-debug.log
.firebase/
