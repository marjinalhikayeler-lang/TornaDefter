# TornaDefter - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.

# Veritabanı
DATABASE_URL="postgresql://tornadefter:tornadefter123@localhost:5432/tornadefter?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=super-secret-key-degistirin
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-refresh-secret-degistirin
JWT_REFRESH_EXPIRES_IN=7d

# Uygulama
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Firebase (Push Bildirim)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# S3 Depolama
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tornadefter-backups
S3_REGION=eu-central-1

# E-posta
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@tornadefter.com

# SMS
SMS_API_KEY=
SMS_SENDER=TornaDefter

# Ödeme
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Şifreleme
ENCRYPTION_KEY=32-karakter-gizli-anahtar-buraya

