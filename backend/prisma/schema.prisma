// ADMİN PANELİ
// ============================================================================

// ============================================================================
// TAKSİT TAKİBİ
// ============================================================================

/// Taksit planı (bir işleme bağlı taksitler)
model InstallmentPlan {
  id              String   @id @default(uuid()) @db.Uuid
  company_id      String   @db.Uuid
  account_id      String   @db.Uuid
  transaction_id  String?  @db.Uuid
  title           String
  total_amount    Int      // Kuruş
  installment_count Int
  start_date      DateTime
  frequency       Frequency @default(MONTHLY)
  notes           String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // İlişkiler
  company      Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [account_id], references: [id], onDelete: Cascade)
  transaction  Transaction?  @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  installments Installment[]

  @@index([company_id])
  @@index([account_id])
  @@index([transaction_id])
  @@map("installment_plans")
}

/// Tek taksit kaydı
model Installment {
  id                 String            @id @default(uuid()) @db.Uuid
  plan_id            String            @db.Uuid
  installment_number Int
  amount             Int               // Kuruş
  due_date           DateTime
  paid_date          DateTime?
  paid_amount        Int?              // Kuruş
  status             InstallmentStatus @default(PENDING)
  payment_method     PaymentMethod?
  notes              String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // İlişkiler
  plan InstallmentPlan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@index([plan_id])
  @@index([due_date])
  @@index([status])
  @@map("installments")
}

// ============================================================================
// VERİ İÇE AKTARMA
// ============================================================================

/// Veri içe aktarma kayıtları
model DataImport {
  id            String   @id @default(uuid()) @db.Uuid
  company_id    String   @db.Uuid
  file_name     String
  file_type     String   // excel, csv
  source_app    String?  // terkon, other
  total_rows    Int      @default(0)
  success_rows  Int      @default(0)
  error_rows    Int      @default(0)
  errors        Json?    // Hata detayları
  status        String   @default("processing") // processing, completed, failed
  imported_by   String   @db.Uuid

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // İlişkiler
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([status])
  @@map("data_imports")
}

/// Admin kullanıcıları
model Admin {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  password_hash      String
  first_name         String
  last_name          String
  role               AdminRole @default(SUPPORT)
  is_active          Boolean   @default(true)
  two_factor_secret  String?
  two_factor_enabled Boolean   @default(false)
  last_login_at      DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  // İlişkiler
  audit_logs AdminAuditLog[]
  user_notes UserNote[]

  @@index([email])
  @@index([is_active])
  @@map("admins")
}

/// Admin denetim kayıtları
model AdminAuditLog {
  id             String  @id @default(uuid()) @db.Uuid
  admin_id       String  @db.Uuid
  action         String
  target_user_id String? @db.Uuid
  entity_type    String?
  entity_id      String?
  details        Json?
  ip_address     String?

  created_at DateTime @default(now())

  // İlişkiler
  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([target_user_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("admin_audit_logs")
}

/// Admin tarafından kullanıcıya eklenen notlar
model UserNote {
  id       String @id @default(uuid()) @db.Uuid
  user_id  String @db.Uuid
  admin_id String @db.Uuid
  note     String

  created_at DateTime @default(now())

  // İlişkiler
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([admin_id])
  @@map("user_notes")
}
